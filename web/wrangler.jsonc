{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Workers deployment (npm run cf:deploy). Free address:
	// https://nutrikal-erp.<account>.workers.dev
	"name": "nutrikal-erp",
	"main": "worker.ts",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Hourly: the price-list sync runs on the first call after 17:00 Sofia time
	"triggers": {
		"crons": ["0 * * * *"]
	},
	// Pooled connection to the Supabase database (engine.ts)
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "0c5b41681ee3412c9f400d030df94384"
		}
	],
	"observability": {
		"enabled": true
	}
	// Secrets (npm run cf:secrets): DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
	// CRON_SECRET, GOOGLE_SHEET_URL, RESEND_API_KEY, MAIL_FROM. The NEXT_PUBLIC_* values are built in.
}
