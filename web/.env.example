# Copy to .env.local and fill in. .env.local is never committed.
# Without the Supabase values the app runs on the local test database
# (web/.data) as the developer user — for development only.

# --- Supabase: Project Settings → API (or the "Connect" button) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or the legacy "anon public" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) or the legacy "service_role" key. Server only:
# used for waybill photos in Storage after the database has checked access.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase database: "Connect" → Connection string → Session pooler ---
# postgresql://postgres.<project-ref>:<DB password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Calculator price list (Google Sheet, shared "Anyone with the link") ---
GOOGLE_SHEET_URL=
# Catalog products (second Google Sheet, synced with the price list). Empty: the link in calculator Settings.
GOOGLE_CATALOG_SHEET_URL=
# Secret for the daily 17:00 sync call (/api/cron/price-sync). Any long random text.
CRON_SECRET=
